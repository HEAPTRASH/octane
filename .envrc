# Loads the Nix dev shell defined in ./flake.nix.
#
# `use flake` comes from direnv's stdlib and re-evaluates the flake on every cd,
# which is slow. Install nix-direnv for caching:
#   nix profile install nixpkgs#nix-direnv
#   echo 'source $HOME/.nix-profile/share/nix-direnv/direnvrc' >> ~/.config/direnv/direnvrc
use flake

# Project-local env. Keep secrets in .env.local (gitignored).
dotenv_if_exists .env.local
