# Rust
/target/
**/*.rs.bk

# direnv / nix
/.direnv/
/result
/result-*

# local secrets and overrides — never committed
/.env.local
# this repo's own provider config, which is developer-local.
# Provider files are designed to be committable (they hold ${VAR}
# references, not keys) — see examples/providers/ for the format.
/.octane/
/OCTANE.local.md
# local agent entrypoint; the content lives in ARCHITECTURE.md
/CLAUDE.md

# research cache (Firecrawl scrapes)
/.firecrawl/

# macOS
.DS_Store

# Scratch worktrees created by parallel design agents.
.claude/worktrees/
